{
  "name": "team-availability-tracker",
  "version": "1.0.0",
  "description": "Simple dashboard showing team availability with toggles synced to SQLite",
  "main": "server.js",
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "start": "npx kill-port 3000 && node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js",
    "format": "prettier --write \"**/*.{js,json,md,css}\""
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "sqlite": "^4.2.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "jest": "^29.6.1",
    "nodemon": "^3.0.1",
    "prettier": "^2.8.8",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
